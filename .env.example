# --- Production (docker-compose.yml) ---
POSTGRES_USER=budgeto
POSTGRES_PASSWORD=change-me-with-a-long-random-password
POSTGRES_DB=budgeto

# Port exposed on the Raspberry Pi. Use 127.0.0.1:3000 to only allow access through the tunnel.
APP_PORT=3000

# Public URL of the app (e.g. https://budgeto.example.com). Optional.
APP_URL=

# --- Cloudflare Tunnel (remote access) ---
# 1. Cloudflare dashboard > Zero Trust > Networks > Tunnels > Create a tunnel (cloudflared), copy the token.
# 2. Public hostname: budgeto.example.com -> Service HTTP, URL app:3000
# 3. Uncomment the two lines below, then `docker compose up -d --build`.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
# Pin a cloudflared release if needed (default: latest)
# CLOUDFLARED_VERSION=latest

# --- Development (npm run dev) ---
# Defaults to the database from docker-compose.dev.yml, override if needed:
# DATABASE_URL=postgres://budgeto:budgeto@localhost:5432/budgeto
